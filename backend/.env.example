# Copy to .env and fill secrets. Never commit `.env`.

# Database
DATABASE_URL=

# Comma-separated browser origins for FastAPI CORS (no trailing slashes).
# Also auto-merged: FLOWPILOT_PUBLIC_ORIGIN, NEXT_PUBLIC_SITE_URL, or PUBLIC_APP_ORIGIN (plus www/apex twin).
# Local dev defaults to localhost:3000 if both CORS_ORIGINS and public site env are unset.
# CORS_ORIGINS=https://app.example.com,https://www.app.example.com
# FLOWPILOT_PUBLIC_ORIGIN=https://flowpilot.officekithr.net

# LLM providers (workspace agents: Groq → Gemini → OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
FAST_MODEL=openai/gpt-4o-mini
SMART_MODEL=anthropic/claude-sonnet-4
VISION_MODEL=openai/gpt-4o
IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_RETRY_COUNT=2
OPENROUTER_CACHE_TTL_SECONDS=90
OPENROUTER_CONCURRENCY_LIMIT=6
OPENROUTER_MAX_TOKENS=8192
# After paid retries / 402, try free-variant models. Leave unset to default to ``openrouter/free`` when OPENROUTER_API_KEY is set.
# Set OPENROUTER_FREE_FALLBACKS=none to disable free-tier fallback entirely.
# OPENROUTER_FREE_FALLBACKS=mistralai/mistral-small-24b-instruct-2501:free,google/gemma-3-27b-it:free

GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

PEXELS_API_KEY=

# OAuth / crypto
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEYS=

# Meta uses META_* OR FACEBOOK_* — set one pair only to avoid drift
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Google OAuth (login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: LinkedIn, Cloudinary, Resend, Supabase … see config.py Settings

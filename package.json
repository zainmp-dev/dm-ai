{
  "name": "dm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:all": "npm run backend:free-port && concurrently -k -n api,web -c magenta,cyan \"npm run backend:dev\" \"npx --yes wait-on -t 120000 -i 200 http-get://127.0.0.1:8011/health && npm run dev\"",
    "dev:all:stable": "npm run backend:free-port && concurrently -k -n api,web -c magenta,cyan \"npm run backend:dev:stable\" \"npx --yes wait-on -t 120000 -i 200 http-get://127.0.0.1:8011/health && npm run dev\"",
    "backend:free-port": "node scripts/backend-free-port.mjs",
    "backend:deps": "./.venv/bin/pip install -r backend/requirements.txt",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "backend:dev": "./.venv/bin/python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --reload --reload-dir backend --reload-delay 2 --port 8011",
    "backend:dev:stable": "./.venv/bin/python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8011 --http h11"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.511.0",
    "next": "^16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.0.6",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
